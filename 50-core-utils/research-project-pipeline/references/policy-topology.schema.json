{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "research-policy-topology-v1",
  "title": "Research Mandatory-Policy Topology",
  "type": "object",
  "required": ["schema_version", "policies", "bindings"],
  "properties": {
    "schema_version": {"const": "research-policy-topology/v1"},
    "execution_roots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "path"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1}
        },
        "additionalProperties": true
      }
    },
    "policies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "path", "sha256", "mandatory", "applies_to"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
          "mandatory": {"type": "boolean"},
          "applies_to": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "known_copies": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        },
        "additionalProperties": true
      }
    },
    "bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["execution_root_id", "policy_id", "type"],
        "properties": {
          "execution_root_id": {"type": "string", "minLength": 1},
          "policy_id": {"type": "string", "minLength": 1},
          "type": {
            "enum": [
              "explicit_reference",
              "verified_loader",
              "owner_approved_isolation"
            ]
          },
          "non_weakening": {"type": "boolean"},
          "semantic_review": {
            "type": "object",
            "required": ["status", "reviewer", "reviewed_at"],
            "properties": {
              "status": {"const": "approved"},
              "reviewer": {"type": "string", "minLength": 1},
              "reviewed_at": {"type": "string", "minLength": 1}
            },
            "additionalProperties": true
          },
          "loader_path": {"type": "string", "minLength": 1},
          "loader_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
          "verification_evidence": {
            "type": "object",
            "required": ["path", "sha256", "result", "covers_execution_root_id", "covers_policy_id"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
              "result": {"const": "pass"},
              "covers_execution_root_id": {"type": "string", "minLength": 1},
              "covers_policy_id": {"type": "string", "minLength": 1}
            },
            "additionalProperties": true
          },
          "approval": {
            "type": "object",
            "required": ["owner", "approved_at", "rationale"],
            "properties": {
              "owner": {"type": "string", "minLength": 1},
              "approved_at": {"type": "string", "minLength": 1},
              "rationale": {"type": "string", "minLength": 1}
            },
            "additionalProperties": true
          }
        },
        "allOf": [
          {
            "if": {"properties": {"type": {"const": "explicit_reference"}}},
            "then": {"required": ["non_weakening", "semantic_review"]}
          },
          {
            "if": {"properties": {"type": {"const": "verified_loader"}}},
            "then": {"required": ["loader_path", "loader_sha256", "verification_evidence"]}
          },
          {
            "if": {"properties": {"type": {"const": "owner_approved_isolation"}}},
            "then": {"required": ["approval"]}
          }
        ],
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
