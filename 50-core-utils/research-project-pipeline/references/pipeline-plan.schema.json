{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "research-project-pipeline-plan-v1",
  "title": "Research Project Pipeline Plan",
  "type": "object",
  "required": [
    "schema_version",
    "pipeline_id",
    "plan_sha256",
    "status",
    "project_root",
    "workspace_fingerprint_sha256",
    "profile",
    "context_action",
    "context_locations",
    "component_interfaces",
    "stages"
  ],
  "properties": {
    "schema_version": {"const": "research-project-pipeline/v1"},
    "pipeline_id": {"type": "string", "minLength": 12},
    "plan_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "status": {"const": "architecture_review_required"},
    "project_root": {"type": "string", "minLength": 1},
    "workspace_fingerprint_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "profile": {"enum": ["lightweight", "collaborative", "controlled"]},
    "context_action": {"enum": ["create_after_framework", "preserve_and_audit"]},
    "context_locations": {
      "type": "array",
      "items": {"enum": [".agents", ".agent"]},
      "uniqueItems": true
    },
    "component_interfaces": {"type": "object"},
    "policy_topology": {
      "type": "object",
      "required": ["schema_version", "status", "execution_roots", "findings", "summary"],
      "properties": {
        "schema_version": {"const": "research-policy-topology/v1"},
        "status": {"enum": ["undeclared", "verified", "conditional", "invalid"]}
      },
      "additionalProperties": true
    },
    "equivalence_contracts": {
      "type": "object",
      "required": ["schema_version", "status", "records", "findings", "summary"],
      "properties": {
        "schema_version": {"const": "research-equivalence-record/v1"},
        "status": {"enum": ["not_declared", "verified", "unverified", "invalid"]}
      },
      "additionalProperties": true
    },
    "role_gaps_for_semantic_review": {"type": "array", "items": {"type": "string"}},
    "stages": {"type": "array", "minItems": 1, "items": {"type": "object"}}
  },
  "additionalProperties": true
}
