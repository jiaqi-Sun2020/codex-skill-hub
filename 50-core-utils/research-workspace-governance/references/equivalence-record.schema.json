{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "research-comparison-record-v2",
  "title": "Research Comparison Record Collection",
  "type": "object",
  "required": ["schema_version", "records"],
  "properties": {
    "schema_version": {"const": "research-comparison-record/v2"},
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id", "type", "scope", "evidence", "comparison_method", "tolerance",
          "invalidation_keys", "allowed_use", "forbidden_inference",
          "domain_review", "status"
        ],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "type": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"},
          "scope": {"type": "object", "minProperties": 1},
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "oneOf": [
                {"required": ["path", "sha256"]},
                {"required": ["external_id", "content_sha256"]}
              ],
              "properties": {
                "path": {"type": "string", "minLength": 1},
                "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
                "external_id": {"type": "string", "minLength": 1},
                "content_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"}
              },
              "additionalProperties": true
            }
          },
          "comparison_method": {
            "type": "object",
            "required": ["name", "result"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "result": {"enum": ["pass", "fail", "unknown"]},
              "profile_id": {"type": "string", "minLength": 1}
            },
            "additionalProperties": true
          },
          "tolerance": {
            "oneOf": [
              {"type": "null"},
              {"type": "number", "minimum": 0},
              {"type": "object", "minProperties": 1},
              {"type": "string", "minLength": 1}
            ]
          },
          "invalidation_keys": {"type": "object", "minProperties": 1},
          "allowed_use": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "forbidden_inference": {
            "type": "array", "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "domain_review": {
            "type": "object",
            "required": ["status"],
            "properties": {
              "status": {"enum": ["approved", "pending", "rejected"]},
              "reviewer": {"type": "string", "minLength": 1},
              "reviewed_at": {"type": "string", "minLength": 1},
              "profile_id": {"type": "string", "minLength": 1}
            },
            "additionalProperties": true
          },
          "status": {"enum": ["verified", "unverified", "stale", "rejected"]}
        },
        "additionalProperties": true
      }
    },
    "current_invalidation_keys": {
      "type": "object",
      "additionalProperties": {"type": "object"}
    }
  },
  "additionalProperties": true
}
