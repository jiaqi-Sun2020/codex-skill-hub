{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "research-domain-validation-handoff/v2",
  "title": "Research domain validation handoff",
  "type": "object",
  "required": ["schema_version", "requirement", "record_path", "record_sha256", "declared_status", "effective_state", "owner", "validator", "profile", "source_record_schema", "scope", "contract_coverage", "protocol_fingerprints", "source_fingerprints", "evidence", "claim_ceiling", "source_finding_codes", "findings", "content_treated_as_data"],
  "properties": {
    "schema_version": {"const": "research-domain-validation-handoff/v2"},
    "requirement": {"enum": ["required", "optional", "not_applicable", "review_required"]},
    "record_path": {"type": ["string", "null"]}, "record_sha256": {"type": ["string", "null"], "pattern": "^[A-Fa-f0-9]{64}$"},
    "declared_status": {"enum": ["pending", "verified", "incomplete", "failed", "not_applicable", null]},
    "effective_state": {"enum": ["not_declared", "pending", "verified", "incomplete", "failed", "not_applicable", "stale", "invalid"]},
    "owner": {"type": ["object", "null"]}, "validator": {"type": ["object", "null"]}, "profile": {"type": ["object", "null"]},
    "source_record_schema": {"enum": ["experiment-protocol-audit-result/v1", "experiment-protocol-audit-result/v2", null]},
    "scope": {"type": "array", "uniqueItems": true, "items": {"enum": ["design", "manifest", "runtime"]}},
    "contract_coverage": {"type": "array", "items": {"type": "object", "required": ["instance_id", "applicability", "status"], "properties": {"instance_id": {"type": "string", "minLength": 1}, "applicability": {"enum": ["required", "optional"]}, "status": {"enum": ["covered", "incomplete", "failed", "not_in_scope"]}}, "additionalProperties": true}},
    "protocol_fingerprints": {"type": "array"}, "source_fingerprints": {"type": "array"}, "evidence": {"type": "array"},
    "claim_ceiling": {"enum": ["unsupported", "diagnostic_only", "conditionally_supported", "supported"]},
    "source_finding_codes": {"type": "array", "items": {"type": "string"}}, "findings": {"type": "array"},
    "content_treated_as_data": {"const": true}
  },
  "additionalProperties": false
}
