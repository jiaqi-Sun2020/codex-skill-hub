{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "engineering-execution-plan.schema.json",
  "title": "engineering-execution-plan/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "plan_id", "plan_sha256", "issue_id", "attempt_id",
    "base_sha", "head_sha", "worktree_fingerprint_sha256", "code_fingerprint_sha256",
    "campaign_binding", "profile_binding", "stage_id", "predecessor_receipt_ref",
    "authorization_ref", "commands", "planned_writes", "protected_paths", "side_effects",
    "transaction", "stop_conditions", "required_verification"
  ],
  "properties": {
    "schema_version": {"const": "engineering-execution-plan/v1"},
    "plan_id": {"$ref": "#/$defs/stable_id"},
    "plan_sha256": {"$ref": "#/$defs/sha256"},
    "issue_id": {"$ref": "#/$defs/stable_id"},
    "attempt_id": {"$ref": "#/$defs/stable_id"},
    "base_sha": {"$ref": "#/$defs/object_id"},
    "head_sha": {"$ref": "#/$defs/object_id"},
    "worktree_fingerprint_sha256": {"$ref": "#/$defs/sha256"},
    "code_fingerprint_sha256": {"$ref": "#/$defs/sha256"},
    "campaign_binding": {"$ref": "#/$defs/optional_binding"},
    "profile_binding": {"$ref": "#/$defs/optional_binding"},
    "stage_id": {"$ref": "#/$defs/stable_id"},
    "predecessor_receipt_ref": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/artifact_ref"}]},
    "authorization_ref": {"$ref": "#/$defs/artifact_ref"},
    "commands": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["cwd", "argv"],
        "properties": {
          "cwd": {"$ref": "#/$defs/project_path"},
          "argv": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        }
      }
    },
    "planned_writes": {"type": "array", "items": {"$ref": "#/$defs/project_path"}},
    "protected_paths": {"type": "array", "items": {"$ref": "#/$defs/project_path"}},
    "side_effects": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "transaction": {
      "type": "object", "additionalProperties": false,
      "required": ["target_identity_sha256", "parent", "name_prefix", "path_budget", "cleanup_conditions", "rollback_conditions"],
      "properties": {
        "target_identity_sha256": {"$ref": "#/$defs/sha256"},
        "parent": {"$ref": "#/$defs/project_path"},
        "name_prefix": {"type": "string", "pattern": "^[.]txn-[a-z0-9-]+-[0-9a-f]{16}-$"},
        "path_budget": {
          "type": "object", "additionalProperties": false,
          "required": ["portable_limit_chars", "final_path_chars", "legacy_staging_path_chars", "staging_path_chars", "max_descendant_relative_chars"],
          "properties": {
            "portable_limit_chars": {"type": "integer", "minimum": 1},
            "final_path_chars": {"type": "integer", "minimum": 1},
            "legacy_staging_path_chars": {"type": "integer", "minimum": 1},
            "staging_path_chars": {"type": "integer", "minimum": 1},
            "max_descendant_relative_chars": {"type": "integer", "minimum": 0}
          }
        },
        "cleanup_conditions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "rollback_conditions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "stop_conditions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "required_verification": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "object_id": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
    "stable_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/#-]{0,255}$"},
    "project_path": {"type": "string", "minLength": 1, "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
    "artifact_ref": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"$ref": "#/$defs/project_path"}, "sha256": {"$ref": "#/$defs/sha256"}}},
    "optional_binding": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "ref", "decision_ref"],
      "properties": {
        "status": {"enum": ["bound", "not_applicable"]},
        "ref": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/artifact_ref"}]},
        "decision_ref": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/artifact_ref"}]}
      }
    }
  }
}
