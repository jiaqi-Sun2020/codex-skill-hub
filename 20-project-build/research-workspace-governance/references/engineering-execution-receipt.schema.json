{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "engineering-execution-receipt.schema.json",
  "title": "engineering-execution-receipt/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "receipt_id", "receipt_sha256", "supersedes", "plan_id",
    "plan_sha256", "issue_id", "attempt_id", "stage_id", "base_sha", "head_sha",
    "worktree_fingerprint_sha256", "code_fingerprint_sha256", "operator", "delegation",
    "started_at", "finished_at", "commands", "changed_files", "write_reconciliation",
    "cleanup", "rollback", "partial_output", "commit", "push", "ci", "failure_class",
    "handoff_state"
  ],
  "properties": {
    "schema_version": {"const": "engineering-execution-receipt/v1"},
    "receipt_id": {"$ref": "#/$defs/stable_id"},
    "receipt_sha256": {"$ref": "#/$defs/sha256"},
    "supersedes": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/artifact_ref"}]},
    "plan_id": {"$ref": "#/$defs/stable_id"},
    "plan_sha256": {"$ref": "#/$defs/sha256"},
    "issue_id": {"$ref": "#/$defs/stable_id"},
    "attempt_id": {"$ref": "#/$defs/stable_id"},
    "stage_id": {"$ref": "#/$defs/stable_id"},
    "base_sha": {"$ref": "#/$defs/object_id"},
    "head_sha": {"$ref": "#/$defs/object_id"},
    "worktree_fingerprint_sha256": {"$ref": "#/$defs/sha256"},
    "code_fingerprint_sha256": {"$ref": "#/$defs/sha256"},
    "operator": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": {"enum": ["human", "agent", "automation"]},
        "id": {"$ref": "#/$defs/stable_id"}
      }
    },
    "delegation": {
      "type": "object", "additionalProperties": false,
      "required": ["task_id", "controller_id", "requested_plan_sha256", "handoff_state"],
      "properties": {
        "task_id": {"$ref": "#/$defs/stable_id"},
        "controller_id": {"$ref": "#/$defs/stable_id"},
        "requested_plan_sha256": {"$ref": "#/$defs/sha256"},
        "handoff_state": {"enum": ["complete", "incomplete", "needs_attention"]}
      }
    },
    "started_at": {"$ref": "#/$defs/timestamp"},
    "finished_at": {"$ref": "#/$defs/timestamp"},
    "commands": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["cwd", "argv", "exit_code", "stdout_ref", "stderr_ref"],
        "properties": {
          "cwd": {"$ref": "#/$defs/project_path"},
          "argv": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "exit_code": {"type": "integer"},
          "stdout_ref": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/artifact_ref"}]},
          "stderr_ref": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/artifact_ref"}]}
        }
      }
    },
    "changed_files": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "before_sha256", "after_sha256"],
        "properties": {
          "path": {"$ref": "#/$defs/project_path"},
          "before_sha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
          "after_sha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]}
        }
      }
    },
    "write_reconciliation": {
      "type": "object", "additionalProperties": false,
      "required": ["planned", "actual", "unexpected"],
      "properties": {
        "planned": {"type": "array", "items": {"$ref": "#/$defs/project_path"}},
        "actual": {"type": "array", "items": {"$ref": "#/$defs/project_path"}},
        "unexpected": {"type": "array", "items": {"$ref": "#/$defs/project_path"}}
      }
    },
    "cleanup": {"enum": ["not_needed", "complete", "incomplete", "failed"]},
    "rollback": {"enum": ["not_needed", "complete", "incomplete", "failed"]},
    "partial_output": {"enum": ["none", "retained", "removed", "unknown"]},
    "commit": {"$ref": "#/$defs/external_state"},
    "push": {"$ref": "#/$defs/push_state"},
    "ci": {"$ref": "#/$defs/external_state"},
    "failure_class": {"enum": ["none", "portability", "infrastructure", "artifact_integrity", "contract", "scientific"]},
    "handoff_state": {"enum": ["complete", "incomplete", "needs_attention"]}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "object_id": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
    "stable_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/#-]{0,255}$"},
    "timestamp": {"type": "string", "format": "date-time"},
    "project_path": {"type": "string", "minLength": 1, "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
    "artifact_ref": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"$ref": "#/$defs/project_path"}, "sha256": {"$ref": "#/$defs/sha256"}}},
    "external_state": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "object_id", "evidence_ref"],
      "properties": {
        "status": {"enum": ["not_attempted", "succeeded", "failed", "pending", "stale", "not_applicable"]},
        "object_id": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/object_id"}]},
        "evidence_ref": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/artifact_ref"}]}
      }
    },
    "push_state": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "evidence_ref", "remote", "updates", "fast_forward_verified", "atomic", "forced", "protection_rejected"],
      "properties": {
        "status": {"enum": ["not_attempted", "succeeded", "failed", "pending", "stale", "not_applicable"]},
        "evidence_ref": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/artifact_ref"}]},
        "remote": {"type": ["string", "null"]},
        "updates": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["ref", "remote_before", "remote_after", "backup_ref"],
            "properties": {
              "ref": {"type": "string", "pattern": "^refs/"},
              "remote_before": {"$ref": "#/$defs/object_id"},
              "remote_after": {"$ref": "#/$defs/object_id"},
              "backup_ref": {"type": ["string", "null"], "pattern": "^refs/codex-backup/"}
            }
          }
        },
        "fast_forward_verified": {"type": ["boolean", "null"]},
        "atomic": {"type": ["boolean", "null"]},
        "forced": {"type": "boolean"},
        "protection_rejected": {"type": "boolean"}
      }
    }
  }
}
