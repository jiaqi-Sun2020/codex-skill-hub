{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "experiment-project-protocol/v2",
  "title": "Experiment project protocol",
  "type": "object",
  "required": ["schema_version", "protocol_id", "version", "profile_id", "owner", "claim_ceiling", "source_paths", "contract_bindings"],
  "properties": {
    "schema_version": {"const": "experiment-project-protocol/v2"},
    "protocol_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "profile_id": {"type": "string", "minLength": 1},
    "owner": {
      "type": "object",
      "required": ["kind", "id"],
      "properties": {"kind": {"enum": ["skill", "human"]}, "id": {"type": "string", "minLength": 1}}
    },
    "claim_ceiling": {"enum": ["unsupported", "diagnostic_only", "conditionally_supported", "supported"]},
    "source_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "contract_bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["instance_id", "applicability", "rule_ids", "audit_checks", "required_scopes"],
        "properties": {
          "instance_id": {"type": "string", "minLength": 1},
          "applicability": {"enum": ["required", "optional"]},
          "rule_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "audit_checks": {"type": "array", "uniqueItems": true, "items": {"enum": ["manifest-identity", "runtime-completeness"]}},
          "required_scopes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["design", "manifest", "runtime"]}},
          "manual_review_ref": {
            "type": "object",
            "required": ["id", "reviewer_ref", "decision", "scopes", "path", "sha256"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "reviewer_ref": {"type": "string", "minLength": 1},
              "decision": {"enum": ["pass", "fail"]},
              "scopes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["design", "manifest", "runtime"]}},
              "path": {"type": "string", "minLength": 1},
              "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  }
}
