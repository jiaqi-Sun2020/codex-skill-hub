{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "experiment-project-protocol/v1",
  "title": "Experiment project protocol",
  "type": "object",
  "required": ["schema_version", "protocol_id", "version", "profile_id", "owner", "claim_ceiling", "source_paths"],
  "properties": {
    "schema_version": {"const": "experiment-project-protocol/v1"},
    "protocol_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "profile_id": {"type": "string", "minLength": 1},
    "owner": {
      "type": "object",
      "required": ["kind", "id"],
      "properties": {"kind": {"enum": ["skill", "human"]}, "id": {"type": "string", "minLength": 1}}
    },
    "claim_ceiling": {"enum": ["unsupported", "diagnostic_only", "conditionally_supported", "supported"]},
    "source_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}
