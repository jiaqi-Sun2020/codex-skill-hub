{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "experiment-protocol-audit-result/v1",
  "title": "Experiment protocol audit result",
  "type": "object",
  "required": ["schema_version", "document_type", "status", "owner", "validator", "profile", "scope", "protocol_fingerprints", "source_fingerprints", "evidence", "claim_ceiling", "findings", "unvalidated"],
  "properties": {
    "schema_version": {"const": "experiment-protocol-audit-result/v1"},
    "document_type": {"const": "domain-validation-record"},
    "status": {"enum": ["verified", "failed"]},
    "claim_ceiling": {"enum": ["unsupported", "diagnostic_only", "conditionally_supported", "supported"]},
    "scope": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["design", "manifest", "runtime"]}},
    "protocol_fingerprints": {"type": "array", "minItems": 1},
    "source_fingerprints": {"type": "array", "minItems": 1},
    "evidence": {"type": "array", "minItems": 1},
    "findings": {"type": "array"},
    "unvalidated": {"type": "array", "items": {"type": "string", "minLength": 1}}
  }
}
